{
  "name": "neubrutalism+",
  "author": "aliofye",
  "version": "1.0.2",
  "keywords": [
    "brutalism",
    "neubrutalism",
    "brutal",
    "pebble-app"
  ],
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "jest": "^29.7.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0"
  },
  "scripts": {
    "test": "jest",
    "design:validate": "node tools/pebble-editor/validate.js"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "pebble": {
    "displayName": "Neubrutalism+",
    "uuid": "673bed2f-68cc-4428-9610-cf5d66d182aa",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "diorite",
      "emery",
      "flint"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "TIME_FORMAT",
      "SETTINGS_REQUEST",
      "COLOR_THEME",
      "DAILY_STEP_GOAL",
      "BARS_MODE",
      "WEATHER_ENABLED",
      "WEATHER_TEMP",
      "WEATHER_UNITS",
      "WEATHER_CODE"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_BT_DISCONNECT",
          "file": "images/bt_disconnect.png"
        },
        {
          "type": "font",
          "name": "FONT_JERSEY_50",
          "file": "fonts/Jersey10-Regular.ttf",
          "size": 50
        },
        {
          "type": "font",
          "name": "FONT_JERSEY_40",
          "file": "fonts/Jersey10-Regular.ttf",
          "size": 40
        },
        {
          "type": "font",
          "name": "FONT_JERSEY_38",
          "file": "fonts/Jersey10-Regular.ttf",
          "size": 38
        },
        {
          "type": "font",
          "name": "FONT_JERSEY_25",
          "file": "fonts/Jersey10-Regular.ttf",
          "size": 25
        }
      ]
    }
  }
}
