      "persist": 8,
      "clay": {
        "type": "select",
        "messageKey": "BARS_MODE",
        "label": "Metric Bars",
        "defaultValue": 0,
        "options": [
          { "label": "Battery + Steps", "value": 0 },
          { "label": "Battery Only", "value": 1 },
          { "label": "Steps Only", "value": 2 }
        ]
      }
    }
