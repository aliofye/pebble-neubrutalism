  "widgets": [
    "time",
    "date",
    "battery",
    "steps",
    "weather"
  ],
  "settings": [
    {
      "var": "bars_mode",
      "key": "BARS_MODE",
      "kind": "int",
      "default": 0,
      "min": 0,
      "max": 2,
      "persist": 8,
      "clay": {
        "type": "select",
        "messageKey": "BARS_MODE",
        "label": "Metric Bars",
        "defaultValue": 0,
        "options": [
          {
            "label": "Battery + Steps",
            "value": 0
          },
          {
            "label": "Battery Only",
            "value": 1
          },
          {
            "label": "Steps Only",
            "value": 2
          }
        ]
      }
    }
  ],
  "constants": {
    "orange_stroke": 3,
    "metric_shadow": 3,
    "shadow_div": 30,
    "outline_stroke": 4
  },
