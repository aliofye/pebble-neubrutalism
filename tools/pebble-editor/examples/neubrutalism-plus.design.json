                    "var": "weather_enabled",
                    "op": "eq",
                    "value": true
                  },
                  {
                    "var": "bt",
                    "op": "eq",
                    "value": false
                  }
                ]
              }
            },
            {
              "kind": "bitmap",
              "id": "bt",
              "center": [
                55,
                28
              ],
              "visibleWhen": {
                "var": "bt",
                "op": "eq",
                "value": false
              }
            }
          ]
        },
        {
          "id": "bars",
          "kind": "graphics",
          "note": "redraw on battery/step/theme/mode change",
          "items": [
            {
              "kind": "meterbar",
              "box": {
                "x": 22,
                "y": "h/5+h/3+orange_stroke+w/shadow_div+((h-(h/5+h/3+orange_stroke+w/shadow_div))-(2*32+8+metric_shadow))/2",
                "w": 155,
                "h": 32
              },
              "stroke": "orange_stroke",
              "shadow": {
                "dx": 2,
                "dy": "metric_shadow"
              },
              "frame": "$battery_frame",
              "core": "$ink",
              "value": "$battery",
              "fill": {
                "cases": [
                  {
                    "when": {
                      "var": "theme.battery_status",
                      "op": "eq",
                      "value": false
                    },
                    "fill": "$battery_bar"
                  },
                  {
                    "when": {
                      "var": "battery",
                      "op": "lt",
                      "value": 20
                    },
                    "fill": "$battery_low"
                  },
                  {
                    "when": {
                      "var": "battery",
                      "op": "lt",
                      "value": 50
                    },
                    "fill": "$battery_mid"
                  }
                ],
                "default": "$battery_high"
              },
              "inset": 3,
              "compact": {
                "maxH": 30,
                "stroke": 3,
                "inset": 2
              },
              "visibleWhen": {
                "var": "bars_mode",
                "op": "eq",
                "value": 0
